# ── WPC Tandil · credenciales e IDs de Meta ──────────────────────────────────
# Este archivo NO va a git (el repo es público). config.json solo lleva copy y targeting.

# Token de system user, durable. Business Settings > Users > System Users > Generate token
# Permisos: ads_management, business_management, pages_show_list, pages_read_engagement
META_ADS_TOKEN=

# Ads Manager, arriba a la izquierda. Va con el prefijo act_
META_AD_ACCOUNT_ID=act_

# Página de FB > Configuración > Información de la página
META_PAGE_ID=

# Business Settings > Cuentas > Instagram. Vacío = los anuncios salen solo en Facebook.
META_IG_USER_ID=

# Orígenes de datos > Pixel. Este mismo id va en index.html (META_PIXEL_ID).
META_PIXEL_ID=
