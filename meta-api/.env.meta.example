# ── WPC Tandil · credenciales e IDs de Meta ──────────────────────────────────
# Este archivo NO va a git (el repo es público). config.json solo lleva copy y targeting.

# Token. Camino corto (el que usamos): developers.facebook.com/tools/explorer
#   → Meta App: "wpc tandil ads" → permisos: ads_management, ads_read,
#     business_management, pages_show_list, pages_read_engagement, instagram_basic
#   → Generate Access Token → copiar.
#   Dura 1-2 horas: alcanza para crear la campaña. Si vence, se genera otro igual.
# Camino durable (solo si después querés un dashboard de métricas corriendo solo):
#   usuario del sistema en el portfolio comercial, token con vencimiento "Nunca".
META_ADS_TOKEN=

# Los cuatro de abajo NO hace falta buscarlos a mano:
# pegá el token y corré  python3 descubrir-ids.py  → te los imprime listos para pegar.
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_IG_USER_ID=
META_PIXEL_ID=
